---
import BaseHead, { type Props } from "../components/BaseHead.astro";
import Header from "../components/Header.astro";

const metadata = Astro.props;
---

<html lang="en-GB" dir="ltr">
  <BaseHead {...metadata} />
  <body
    class="absolute inset-0 flex flex-col overflow-hidden font-sans text-sm text-black sm:text-base dark:bg-black dark:text-white"
  >
    <Header />
    <main class="overflow-y-auto scroll-smooth subpixel-antialiased">
      <div
        class="container ms-4 flex max-w-[18rem] flex-col py-3 sm:ms-6 sm:max-w-lg sm:py-6 md:max-w-xl lg:max-w-3xl xl:max-w-4xl 2xl:max-w-5xl"
      >
        <slot />
        <p class="ms-2 mt-2 text-xs text-neutral-500">Seen</p>
      </div>
    </main>
  </body>
</html>
