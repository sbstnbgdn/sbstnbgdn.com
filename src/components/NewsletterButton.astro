---
import type { Link } from "../data/newsletter";
import ExternalLink from "./ExternalLink.astro";

const { link } = Astro.props as {
  link: Link;
};
---

<ExternalLink
  href={link.href}
  class={`mx-auto block ${link.width} rounded ${link.background} py-3 font-bold text-white`}
  >{link.label}</ExternalLink
>
